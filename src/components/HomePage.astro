---
import SiteLayout from '@/layouts/SiteLayout.astro'
import ProfileIntro from './ProfileIntro'
import PostRows from './PostRows.astro'
import { ChevronLeft, ChevronRight } from 'lucide-react'
import { getPostSummaries } from '@/lib/posts'
interface Props { page?: number }
const { page = 1 } = Astro.props
const posts = await getPostSummaries()
const lastPage = Math.ceil(posts.length / 8)
const pageUrl = (value: number) => value === 1 ? '/#recent-posts' : `/page/${value}/#recent-posts`
---
<SiteLayout title={page === 1 ? '博客' : `博客 · 第 ${page} 页`}>
  <main id="main" tabindex="-1" class="page home-page">
    <ProfileIntro client:load />
    <section id="recent-posts" class="recent-posts">
      <div class="section-heading"><h2>最近文章</h2></div>
      <PostRows posts={posts.slice((page - 1) * 8, page * 8)} />
      {lastPage > 1 && <nav class="pagination" aria-label="文章分页">
        {page > 1 && <a href={pageUrl(page - 1)} class="pagination-link pagination-prev" rel="prev"><ChevronLeft aria-hidden="true" />上一页</a>}
        <span class="pagination-status">{page} <span class="muted">/ {lastPage}</span></span>
        {page < lastPage && <a href={pageUrl(page + 1)} class="pagination-link pagination-next" rel="next">下一页<ChevronRight aria-hidden="true" /></a>}
      </nav>}
    </section>
  </main>
</SiteLayout>
