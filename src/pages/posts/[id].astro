---
import { render } from 'astro:content'
import { ArrowLeft } from 'lucide-react'
import SiteLayout from '@/layouts/SiteLayout.astro'
import ArticleToc from '@/components/ArticleToc.astro'
import PostMeta from '@/components/PostMeta.astro'
import ArticleEnhancements from '@/components/ArticleEnhancements'
import Comments from '@/components/Comments'
import { Badge } from '@/components/ui/badge'
import { Separator } from '@/components/ui/separator'
import { getPosts, getPostSummaries, postUrl } from '@/lib/posts'

export async function getStaticPaths() {
  return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } }))
}
const { post } = Astro.props
const posts = await getPostSummaries()
const index = posts.findIndex(item => item.id === post.id)
const summary = posts[index]
const { Content, headings: markdownHeadings } = await render(post)
// Historical HTML is already sanitized during migration. Render it without a
// second Markdown pass so blank lines inside legacy code blocks stay exact.
const legacyHtml = post.data.legacySlug ? post.body : undefined
const headings = post.data.legacySlug ? post.data.headings : markdownHeadings.map(heading => ({ id: heading.slug, text: heading.text, level: heading.depth }))
---
<SiteLayout title={post.data.title} description={post.data.excerpt} article={{ title: post.data.title, date: post.data.date }}>
  <div class:list={['article-layout', { 'without-toc': headings.length === 0 }]}>
    {headings.length > 0 && <aside class="article-sidebar"><div class="toc-panel"><h2>目录</h2><ArticleToc headings={headings} /></div></aside>}
    <main id="main" tabindex="-1" class="page article-page">
      <a class="article-back" href="/"><ArrowLeft aria-hidden="true" />返回博客</a>
      <header class="article-heading"><h1>{post.data.title}</h1><PostMeta post={summary} /><div class="article-tags">{post.data.tags.slice(0, 5).map(tag => <Badge variant="secondary">{tag}</Badge>)}</div></header>
      {headings.length > 0 && <details class="mobile-toc"><summary>目录</summary><ArticleToc headings={headings} /></details>}
      {legacyHtml !== undefined ? <div class="article-body" set:html={legacyHtml} /> : <div class="article-body"><Content /></div>}
      <ArticleEnhancements postId={post.id} client:load />
      {post.data.imageOmitted && <p class="article-note">此篇部分配图尚未恢复。</p>}
      <Comments postId={post.id} client:load />
      <Separator />
      <nav class="adjacent-posts" aria-label="相邻文章">
        {index > 0 && <a href={postUrl(posts[index - 1].id)}><span>较新一篇</span><strong>{posts[index - 1].title}</strong></a>}
        {index < posts.length - 1 && <a href={postUrl(posts[index + 1].id)}><span>较早一篇</span><strong>{posts[index + 1].title}</strong></a>}
      </nav>
    </main>
  </div>
</SiteLayout>
<script>
  import { activeArticleHeading, articleAnchorProtection, articleHeadingFromHash, articleReadingHash } from '@/lib/article-toc'
  import type { ArticleAnchorProtection } from '@/lib/article-toc'

  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')]
  const headings = [...document.querySelectorAll<HTMLElement>('.article-body :is(h1,h2,h3,h4,h5,h6)[id]')]
  const headingIds = headings.map(heading => heading.id)
  const articleBody = document.querySelector<HTMLElement>('.article-body')
  let anchorId = articleHeadingFromHash(location.hash, headingIds)
  let activeId: string | undefined
  let queued = false
  let syncReadingAddress = false
  let protectedAnchor: ArticleAnchorProtection | undefined
  function select(id: string | undefined) {
    if (id === activeId) return
    activeId = id
    links.forEach(link => link.dataset.heading === id ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current'))
  }
  function update() {
    queued = false
    const syncAddress = syncReadingAddress
    syncReadingAddress = false
    const scrollY = window.scrollY
    const root = document.documentElement
    const padding = parseFloat(getComputedStyle(root).scrollPaddingTop) || 0
    const maxScrollY = Math.max(0, root.scrollHeight - root.clientHeight)
    const positions = headings.map(heading => ({
      id: heading.id,
      top: heading.getBoundingClientRect().top + scrollY,
      offset: padding + (parseFloat(getComputedStyle(heading).scrollMarginTop) || 0),
    }))
    select(activeArticleHeading(positions, scrollY, maxScrollY, anchorId))
    const commentId = articleHeadingFromHash(location.hash, ['comments', 'comments-title'])
    const commentTarget = commentId ? document.getElementById(commentId) : null
    const commentDestination = commentTarget
      ? Math.max(0, Math.min(maxScrollY, commentTarget.getBoundingClientRect().top + scrollY - padding - (parseFloat(getComputedStyle(commentTarget).scrollMarginTop) || 0)))
      : undefined
    // Capture the initial clamped position even before any scroll event. Giscus
    // can later increase page height without moving the reader from that position.
    protectedAnchor = articleAnchorProtection(protectedAnchor, location.hash, commentDestination)
    // Only scrolling changes the shareable address. Initial rendering and late
    // layout changes must not overwrite a deep link before native navigation.
    if (syncAddress && articleBody) {
      const hash = articleReadingHash(positions, scrollY, articleBody.getBoundingClientRect().bottom + scrollY, activeId, location.hash, protectedAnchor?.scrollY)
      if (hash !== undefined && hash !== location.hash) {
        // Replace, rather than push, so reading does not fill browser history.
        // Do not change anchorId: it is reserved for explicit navigation.
        history.replaceState(history.state, '', location.pathname + location.search + hash)
      }
    }
  }
  function scheduleUpdate() {
    if (queued) return
    queued = true
    requestAnimationFrame(update)
  }
  window.addEventListener('scroll', () => {
    syncReadingAddress = true
    scheduleUpdate()
  }, { passive: true })
  window.addEventListener('resize', scheduleUpdate)
  function locationChanged() {
    anchorId = articleHeadingFromHash(location.hash, headingIds)
    syncReadingAddress = false
    protectedAnchor = undefined
    scheduleUpdate()
  }
  window.addEventListener('hashchange', locationChanged)
  window.addEventListener('popstate', locationChanged)
  window.addEventListener('pageshow', event => {
    // Initial pageshow may follow widget loading; keep the first destination.
    if (event.persisted) locationChanged()
    else scheduleUpdate()
  })
  document.fonts.ready.then(scheduleUpdate)
  // Late images, code highlighting and the comment widget can change positions
  // without a scroll event. Re-read geometry instead of caching heading tops.
  const resizeObserver = new ResizeObserver(scheduleUpdate)
  resizeObserver.observe(document.body)
  if (articleBody) resizeObserver.observe(articleBody)

  links.forEach(link => link.addEventListener('click', event => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
    const target = document.getElementById(link.dataset.heading || '')
    if (!target) return
    event.preventDefault()
    document.querySelector<HTMLDetailsElement>('.mobile-toc')?.removeAttribute('open')
    anchorId = target.id
    syncReadingAddress = false
    select(anchorId)
    // Native fragment navigation records scroll restoration for Back/Forward.
    if (location.hash !== link.hash) location.hash = link.hash
    target.scrollIntoView({ block: 'start', behavior: 'instant' })
    target.setAttribute('tabindex', '-1')
    target.focus({ preventScroll: true })
    scheduleUpdate()
  }))
  document.querySelectorAll<HTMLAnchorElement>('.article-body a[href]').forEach(link => {
    if (link.protocol === 'https:' || link.protocol === 'http:') {
      if (link.origin !== location.origin) { link.target = '_blank'; link.rel = 'noopener noreferrer' }
    }
  })
  update()
</script>
